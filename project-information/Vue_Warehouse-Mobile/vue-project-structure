.hamburger-menu {
    padding-left: 1.25em;
    position: relative;
    height: 19px;
    margin-right: 9px;
    display: none;
}

.hamburger-menu:before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.21em;
    bottom: 0.21em;
    width: 1em;
    background: linear-gradient(
            to bottom,
            black, black 20%,
            white 20%, white 40%,
            black 40%, black 60%,
            white 60%, white 80%,
            black 80%, black 100%
    );
}
