/**
 * ----------------------------------------
 * @animation text-shadow-drop-center
 * ----------------------------------------
 */
@-webkit-keyframes text-shadow-drop-center {
  0% {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
  }
  100% {
    text-shadow: 0 0 18px rgba(0, 0, 0, 0.35);
  }
}
@keyframes text-shadow-drop-center {
  0% {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
  }
  100% {
    text-shadow: 0 0 18px rgba(0, 0, 0, 0.35);
  }
}















.shadow-drop-center {
	-webkit-animation: shadow-drop-center 0.3s cubic-bezier(0.550, 0.085, 0.680, 0.530) 2 both;
	        animation: shadow-drop-center 0.3s cubic-bezier(0.550, 0.085, 0.680, 0.530) 2 both;
}


/* ----------------------------------------------
 * Generated by Animista on 2019-2-2 1:31:12
 * w: http://animista.net, t: @cssanimista
 * ---------------------------------------------- */

/**
 * ----------------------------------------
 * animation shadow-drop-center
 * ----------------------------------------
 */
@-webkit-keyframes shadow-drop-center {
  0% {
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
  }
  100% {
    box-shadow: 0 0 20px 0px rgba(0, 0, 0, 0.35);
  }
}
@keyframes shadow-drop-center {
  0% {
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
  }
  100% {
    box-shadow: 0 0 20px 0px rgba(0, 0, 0, 0.35);
  }
}










#animated-example { 
   background: #cd4436; 
   height: 200px; 
   margin: 20px auto; 
   width: 300px; 
   box-shadow: inset 0 0 7px rgba(0,0,0,0.7); 
}

.animated { 
    animation-duration: 1s; 
    animation-fill-mode: both; 
} 

@keyframes flash { 
    0%, 50%, 100% {opacity: 1;} 
    25%, 75% {opacity: 0;} 
} 
.flash { 
    animation-name: flash; 
}










