.text-shadow-drop-center {
	-webkit-animation: text-shadow-drop-center 0.2s 2 both;
	        animation: text-shadow-drop-center 0.2s 2 both;
}



/* ----------------------------------------------
 * Generated by Animista on 2019-2-2 1:23:16
